# Optional local developer settings. Copy to .env.
# Port 8081 avoids the original desktop repository's local web test on 8080.
MEOSAR_BIND_ADDRESS=127.0.0.1
MEOSAR_PORT=8081

# After creating a certificate, optionally enable local HTTPS for plain compose commands:
# COMPOSE_FILE=compose.yaml:compose.https.yaml
# MEOSAR_HTTPS=1
# MEOSAR_HTTPS_PORT=4443
