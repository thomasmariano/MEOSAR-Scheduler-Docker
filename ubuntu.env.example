# Copy to ubuntu.env on the Ubuntu server. No application login is used.
# Use 0.0.0.0 for all server interfaces, or the server LAN IP for one interface.
MEOSAR_BIND_ADDRESS=0.0.0.0
MEOSAR_PORT=8080
# Leave unset to use the project tle-imports folder.
# MEOSAR_TLE_IMPORT_DIR=/srv/meosar/tle-imports

# Bounded browser-assisted video export limits.
MEOSAR_VIDEO_MAX_SECONDS=600
MEOSAR_VIDEO_MAX_FRAMES=18000
MEOSAR_VIDEO_SESSION_SECONDS=7200

# nginx HTTPS: supply certs/server.crt + server.key before starting.
# Uses 4443 to coexist with other HTTPS services; change to another available host port if needed.
MEOSAR_HTTPS=1
MEOSAR_HTTPS_PORT=4443
# MEOSAR_CERT_DIRECTORY=/srv/meosar/certs

# Optional regular host folder: see docs/FILE_STORAGE.md before enabling.
# MEOSAR_FILES_DIRECTORY=/srv/meosar-files
# Match the non-root account that owns that folder (id -u / id -g):
# MEOSAR_UID=1000
# MEOSAR_GID=1000
