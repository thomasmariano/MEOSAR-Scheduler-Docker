# Copy to ubuntu.env on the Ubuntu server. No application login is used.
# Use 0.0.0.0 for all server interfaces, or the server LAN IP for one interface.
MEOSAR_BIND_ADDRESS=0.0.0.0
MEOSAR_PORT=8080
# Leave unset to use the project tle-imports folder.
# MEOSAR_TLE_IMPORT_DIR=/srv/meosar/tle-imports

# Bounded browser-assisted video export limits.
MEOSAR_VIDEO_MAX_SECONDS=600
MEOSAR_VIDEO_MAX_FRAMES=18000
MEOSAR_VIDEO_SESSION_SECONDS=7200
